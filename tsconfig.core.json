{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["core/**/*"],
  "exclude": [
    "core/**/*.test.*",
    "core/**/*.spec.*",
    "core/**/__tests__/**",
    "core/**/test-support/**"
  ]
}
