{
  "name": "@pluribus/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "setup": "convex dev --once",
    "codegen": "convex codegen",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project backend"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.95",
    "convex": "^1.45.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.56",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
