{
  "name": "convex-hackathon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev --workspace=@pluribus/frontend --",
    "dev:backend": "npm run dev --workspace=@pluribus/backend",
    "setup:backend": "npm run setup --workspace=@pluribus/backend && npm run sync:frontend-env",
    "codegen": "npm run codegen --workspace=@pluribus/backend",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:core",
    "build": "npm run typecheck && npm run build --workspace=@pluribus/frontend",
    "preview": "npm run preview --workspace=@pluribus/frontend --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run check:architecture && npm run typecheck && npm test && npm run format:check",
    "typecheck:core": "node scripts/CheckCore.mjs",
    "check:architecture": "node scripts/CheckArchitecture.mjs",
    "sync:frontend-env": "node scripts/SyncFrontendEnv.mjs",
    "dev:design": "npm run dev:design --workspace=@pluribus/frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "dependency-cruiser": "^18.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "apps/*"
  ]
}
