{
  "name": "convex-hackathon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:backend": "convex dev",
    "setup:backend": "convex dev --once",
    "codegen": "convex codegen",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json && npm run typecheck:core",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run check:architecture && npm run typecheck && npm test && npm run format:check",
    "typecheck:core": "node scripts/CheckCore.mjs",
    "check:architecture": "node scripts/CheckArchitecture.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@internationalized/date": "^3.12.4",
    "@react-stately/color": "^3.10.1",
    "@tailwindcss/vite": "^4.3.3",
    "convex": "^1.45.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.56",
    "dependency-cruiser": "^18.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
